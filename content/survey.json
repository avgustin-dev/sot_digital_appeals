        {
          "id": "q1o4",
          "textRu": "Я был(а) в здании суда как посетитель или сопровождающий другого человека",
          "textKy": "Мен сот имаратында зыяратчы же коштоочу болдум",
          "isOther": false
        },
        {
          "id": "q1o5",
          "textRu": "Другое (укажите)",
          "textKy": "Башка (көрсөтүңүз)",
